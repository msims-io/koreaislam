---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import QuestionCard from '../components/QuestionCard.astro';
import { UI, localePath, type Lang } from '../i18n';

interface Props { q: any; all: any[]; lang: Lang }
const { q, all, lang } = Astro.props;
const t = UI[lang];
const { Content } = await render(q);
const related = (q.data.related as string[]).map((id) => all.find((x) => x.id === id)).filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: [{ '@type': 'Question', name: q.data.title, acceptedAnswer: { '@type': 'Answer', text: q.data.answer } }],
};
const cat = t.categories[q.data.category as keyof typeof t.categories];
---
<Base title={q.data.title} description={q.data.answer} jsonLd={jsonLd} lang={lang}>
  <article class="prose">
    <p class="eyebrow"><a href={localePath(lang, `/questions/#${q.data.category}`)}>{t.q.section} · {cat}</a></p>
    <h1>{q.data.title}</h1>
    <div class="answer-box">
      <strong>{t.q.short}</strong>
      <p>{q.data.answer}</p>
    </div>
    <Content />
    {q.data.sources.length > 0 && (
      <div class="sources">
        <strong>{t.q.sources}</strong>
        <ul>{q.data.sources.map((s: string) => <li>{s}</li>)}</ul>
        <p class="small">
          {q.data.reviewed ? t.q.reviewed : t.q.draft}{' '}
          <a href={localePath(lang, '/ask/')}>{t.q.feedback}</a>
        </p>
      </div>
    )}
  </article>
  {related.length > 0 && (
    <section class="container" style="margin-top:48px">
      <h2 style="font-size:1.15rem">{t.q.related}</h2>
      <div class="grid">
        {related.map((r: any) => <QuestionCard id={r.id} title={r.data.title} answer={r.data.answer} lang={lang} />)}
      </div>
    </section>
  )}
</Base>
