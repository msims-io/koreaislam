---
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { UI, localePath, type Lang } from '../i18n';

interface Props { all: any[]; lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];
const all = [...Astro.props.all].sort((a, b) => a.data.order - b.data.order);
const groups = Object.entries(t.categories)
  .map(([key, label]) => ({ key, label, items: all.filter((q) => q.data.category === key) }))
  .filter((g) => g.items.length > 0);
const bodies = await Promise.all(all.map(async (q) => ({ q, Content: (await render(q)).Content })));
---
<Base title={t.q.indexTitle} description={t.q.indexDesc} lang={lang}>
  <div class="container qa">
    <div class="reader-head">
    <h1>{t.q.indexTitle}</h1>
    <p class="muted" style="max-width:640px">{t.q.indexIntro}</p>
    <div class="search">
      <label for="q" class="sr">{t.q.searchLabel}</label>
      <input id="q" type="search" placeholder={t.q.searchPlaceholder} autocomplete="off" />
      <p id="empty" class="muted" hidden>{t.q.empty} <a href={localePath(lang, '/ask/')}>{t.q.emptyLink}</a></p>
    </div>
    </div>
    <div class="reader">
      <nav class="reader-list" aria-label={t.q.indexTitle}>
        {groups.map((g) => (
          <section class="group" id={g.key} data-group>
            <h2>{g.label}</h2>
            <ul class="qlist">
              {g.items.map((q) => (
                <li data-search={[q.data.title, q.data.answer, ...q.data.keywords].join(' ').toLowerCase()}>
                  <a href={localePath(lang, `/questions/${q.id}/`)} data-q={q.id}>{q.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </nav>
      <div class="reader-pane" id="pane" data-nosnippet>
        {bodies.map(({ q, Content }) => (
          <article class="prose" id={`a-${q.id}`} data-answer={q.id} hidden>
            <p class="eyebrow">{t.categories[q.data.category as keyof typeof t.categories]}</p>
            <h2 class="pane-title">{q.data.title}</h2>
            <div class="answer-box">
              <strong>{t.q.short}</strong>
              <p>{q.data.answer}</p>
            </div>
            <Content />
            {q.data.sources.length > 0 && (
              <div class="sources">
                <strong>{t.q.sources}</strong>
                <ul>{q.data.sources.map((s: string) => <li>{s}</li>)}</ul>
                <p class="small">
                  {q.data.reviewed ? t.q.reviewed : t.q.draft}{' '}
                  <a href={localePath(lang, '/ask/')}>{t.q.feedback}</a>
                </p>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </div>
</Base>
<style>
  .search { max-width: 560px; margin: 20px 0 8px; }
  .sr { position: absolute; left: -9999px; }
  .qlist { list-style: none; padding: 0; margin: 0; }
  .qlist li { border-bottom: 1px solid var(--surface-2); }
  .qlist li:last-child { border-bottom: 0; }
  .qlist a { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 2px; color: var(--text); text-decoration: none; font-weight: 500; font-size: 1.05rem; }
  .qlist a::after { content: '›'; color: var(--muted); font-size: 1.3rem; line-height: 1; }
  .qlist a:hover { color: var(--accent); }
  .group h2 { font-size: 1.15rem; color: var(--text); margin-top: 40px; }
  .reader-pane { display: none; }
  @media (min-width: 960px) {
    /* App-style reader: the list and the answer are two separate scroll areas that fill the window. */
    :global(main:has(.qa)) { padding: 0; }
    :global(body:has(.qa)) { --wide: 1440px; }
    :global(body:has(.qa) .container) { padding-left: 32px; padding-right: 32px; }
    .qa { display: grid; grid-template-columns: minmax(280px, 360px) minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr); column-gap: 56px; height: calc(100vh - 65px); height: calc(100dvh - 65px); min-height: 420px; }
    .reader { display: contents; }
    .reader-head { grid-column: 1; grid-row: 1; padding: 28px 0 12px; }
    .reader-head h1 { font-size: 1.6rem; margin: 0 0 6px; }
    .reader-head .muted { font-size: 0.92rem; line-height: 1.5; margin: 0; }
    .search { margin: 14px 0 0; }
    .reader-list { grid-column: 1; grid-row: 2; overflow-y: auto; padding: 0 8px 32px 0; scrollbar-width: thin; }
    .reader-list .group:first-child h2 { margin-top: 12px; }
    .reader-list .group h2 { font-size: 0.9rem; color: var(--muted); margin: 28px 0 4px; }
    .qlist a { padding: 12px 12px; font-size: 1rem; border-radius: 12px; }
    .qlist li { border-bottom: 0; }
    .qlist a[aria-current='true'] { background: var(--accent-soft); color: var(--accent-strong); font-weight: 600; }
    .reader-pane { display: block; grid-column: 2; grid-row: 1 / 3; overflow-y: auto; padding: 36px 12px 64px 0; scrollbar-width: thin; }
    .reader-pane .prose { margin: 0; padding: 0; max-width: 800px; }
    .pane-title { font-size: 2rem; line-height: 1.25; margin: 0 0 20px; }
  }
</style>
<script>
  const input = document.getElementById('q') as HTMLInputElement;
  const empty = document.getElementById('empty')!;
  const run = () => {
    const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
      let n = 0;
      g.querySelectorAll<HTMLElement>('li').forEach((li) => {
        const hit = terms.every((t) => (li.dataset.search || '').includes(t));
        li.hidden = !hit;
        if (hit) n++;
      });
      g.hidden = n === 0;
      shown += n;
    });
    empty.hidden = shown > 0;
  };
  const wide = window.matchMedia('(min-width: 960px)');
  const pane = document.getElementById('pane')!;
  const show = (id: string, scroll: boolean) => {
    const target = pane.querySelector<HTMLElement>(`[data-answer="${CSS.escape(id)}"]`);
    if (!target) return false;
    pane.querySelectorAll<HTMLElement>('[data-answer]').forEach((a) => (a.hidden = a !== target));
    document.querySelectorAll<HTMLElement>('.qlist a').forEach((a) => {
      if (a.dataset.q === id) { a.setAttribute('aria-current', 'true'); a.scrollIntoView({ block: 'nearest' }); }
      else a.removeAttribute('aria-current');
    });
    if (scroll) {
      history.replaceState(null, '', `#${id}`);
      pane.scrollTop = 0;
    }
    return true;
  };
  document.querySelector('.reader')!.addEventListener('click', (e) => {
    if (!wide.matches || e.metaKey || e.ctrlKey || e.shiftKey) return;
    const a = (e.target as HTMLElement).closest('a');
    if (!a) return;
    const m = new URL(a.href, location.href).pathname.match(/\/questions\/([^/]+)\/$/);
    if (m && show(m[1], true)) e.preventDefault();
  });
  const first = document.querySelector<HTMLElement>('.qlist a')?.dataset.q;
  if (!show(decodeURIComponent(location.hash.slice(1)), false) && first) show(first, false);
  const initial = new URLSearchParams(location.search).get('q');
  if (initial) input.value = initial;
  input.addEventListener('input', run);
  run();
</script>
