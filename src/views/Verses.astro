---
import Base from '../layouts/Base.astro';
import { VERSES, THEMES, type VerseTheme } from '../data/verses';
import { type Lang } from '../i18n';
interface Props { lang?: Lang }
const { lang = 'ko' } = Astro.props;
const en = lang === 'en';
const T = en
  ? {
      title: 'Verses that touch the heart',
      desc: 'Short passages from the Quran that Muslims carry with them: on comfort, mercy, family, neighbours, animals, peace and the purpose of life.',
      intro: 'The Quran is the book Muslims believe God revealed to the Prophet Muhammad. These are short passages that many Muslims know by heart and return to in ordinary life. Read them slowly. A few entries are sayings of the Prophet Muhammad, and they are labelled as such.',
      quran: 'Quran',
      draft: 'These are plain-language renderings made for this site and are still being checked by a scholar against the Arabic. Some are excerpts from longer verses.',
      jump: 'Themes',
    }
  : {
      title: '마음에 닿는 구절',
      desc: '무슬림들이 마음에 품고 사는 꾸란의 짧은 구절들. 위로와 자비, 가족과 이웃, 동물, 평화, 그리고 삶의 목적에 대하여.',
      intro: '꾸란은 무슬림들이 하나님께서 예언자 무함마드에게 내려 주셨다고 믿는 경전이에요. 여기에는 많은 무슬림이 외우고, 일상에서 자주 떠올리는 짧은 구절들을 모았어요. 천천히 읽어 보세요. 몇몇은 예언자 무함마드의 말씀이며, 그렇게 표시해 두었어요.',
      quran: '꾸란',
      draft: '이 사이트를 위해 쉬운 말로 옮긴 번역이며, 학자가 아랍어 원문과 대조해 검토하는 중이에요. 일부는 긴 구절의 한 부분이에요.',
      jump: '주제',
    };
const themes = Object.keys(THEMES) as VerseTheme[];
---
<Base title={T.title} description={T.desc} lang={lang}>
  <div class="container">
    <h1>{T.title}</h1>
    <p class="muted intro">{T.intro}</p>
    <nav class="chips" aria-label={T.jump}>
      {themes.map((k) => <a class="chip" href={`#${k}`}>{en ? THEMES[k].en : THEMES[k].ko}</a>)}
    </nav>
    {themes.map((k) => (
      <section class="theme" id={k} aria-labelledby={`${k}-h`}>
        <h2 id={`${k}-h`}>{en ? THEMES[k].en : THEMES[k].ko}</h2>
        <p class="muted sub">{en ? THEMES[k].enSub : THEMES[k].koSub}</p>
        <div class="verses">
          {VERSES.filter((v) => v.theme === k).map((v) => (
            <figure class="verse">
              <blockquote>{en ? v.en : v.ko}</blockquote>
              <figcaption>{v.hadith ? (en ? v.hadith.en : v.hadith.ko) : `${T.quran} ${v.ref}`}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))}
    <p class="notice draft">{T.draft}</p>
  </div>
</Base>
<style>
  .intro { max-width: 640px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 8px; }
  .chip { text-decoration: none; font-size: 0.92rem; font-weight: 600; padding: 8px 14px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-strong); }
  .theme { margin-top: 48px; scroll-margin-top: 84px; }
  .theme h2 { margin: 0 0 4px; }
  .sub { margin: 0 0 18px; font-size: 0.97rem; }
  .verses { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .verse { margin: 0; background: var(--surface); border-radius: var(--radius-lg); padding: 28px 26px 22px; display: flex; flex-direction: column; justify-content: space-between; gap: 18px; }
  .verse blockquote { margin: 0; font-size: 1.18rem; line-height: 1.75; font-weight: 500; letter-spacing: -0.02em; color: var(--text); }
  .verse figcaption { font-size: 0.88rem; font-weight: 600; color: var(--accent); }
  .draft { margin-top: 40px; max-width: 720px; }
</style>
