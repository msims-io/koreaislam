---
import { SITE } from '../config';
import { UI, localePath, type Lang } from '../i18n';
interface Props { heading?: string; lang?: Lang }
const { lang = 'ko' } = Astro.props;
const t = UI[lang].next;
const heading = Astro.props.heading ?? t.heading;
const kakao = SITE.kakaoUrl || localePath(lang, '/ask/');
---
<section class="next-step container" aria-labelledby="next-step-title">
  <div class="inner">
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="next-step-title">{heading}</h2>
      <p class="muted">{t.body}</p>
    </div>
    <div class="actions">
      <a class="btn btn-primary" href={kakao} target={SITE.kakaoUrl ? '_blank' : undefined} rel={SITE.kakaoUrl ? 'noopener' : undefined}>{t.kakao}</a>
      <a class="btn btn-ghost" href={localePath(lang, '/mosques/')}>{t.mosque}</a>
    </div>
  </div>
</section>
<style>
  .next-step { margin-top: 56px; }
  .inner { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 28px; display: grid; gap: 20px; align-items: center; }
  @media (min-width: 760px) { .inner { grid-template-columns: 1fr auto; padding: 32px 36px; } }
  h2 { margin: 0 0 8px; }
  p.muted { margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (max-width: 480px) { .actions .btn { width: 100%; } }
</style>
