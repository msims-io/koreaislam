---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import QuestionCard from '../../components/QuestionCard.astro';

const FEATURED = ['violence', 'hijab', 'jesus', 'allah', 'halal', 'women-rights'];
const all = await getCollection('questionsEn');
const featured = FEATURED.map((id) => all.find((q) => q.id === id)).filter((q) => q !== undefined);
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Curious about Islam', inLanguage: 'en' };
---
<Base jsonLd={jsonLd} lang="en">
  <section class="hero container">
    <p class="eyebrow">Answered by Korean Muslims</p>
    <h1>Honest answers about Islam,<br />in plain words.</h1>
    <p class="lead">Terrorism, hijab, Jesus, halal. If you only know Islam from the news and feel curious or worried, take your time here. Nobody will tell you what to believe.</p>
    <p class="small muted">This is the English version of a site written for Korean readers.</p>
    <form class="hero-search" action="/en/questions/" method="get" role="search">
      <input type="search" name="q" placeholder="Search a question (e.g. hijab)" aria-label="Search questions" />
      <button class="btn btn-primary" type="submit">Search</button>
    </form>
  </section>

  <section class="container section">
    <h2>Most asked questions</h2>
    <div class="grid">
      {featured.map((q) => <QuestionCard id={q.id} title={q.data.title} answer={q.data.answer} lang="en" />)}
    </div>
    <p><a href="/en/questions/">See all questions →</a></p>
  </section>

  <section class="container section">
    <h2>Start from where you are</h2>
    <p class="muted">What people want to know depends on where they are coming from.</p>
    <div class="grid paths">
      <a class="card card-link" href="/en/you/christian/">
        <h3>I'm a Christian</h3>
        <p>The same God of Abraham, Jesus and Mary in the Qur'an, and the differences stated honestly.</p>
      </a>
      <a class="card card-link" href="/en/you/buddhist/">
        <h3>I'm close to Buddhism</h3>
        <p>Taming the mind, precepts and ethics, prayer and fasting as practice.</p>
      </a>
      <a class="card card-link" href="/en/you/non-religious/">
        <h3>I'm not religious</h3>
        <p>Life is fine without religion, so why believe? Questions about reason, science and meaning.</p>
      </a>
    </div>
  </section>

  <section class="container section">
    <div class="card story">
      <p class="eyebrow">Korea and Islam</p>
      <h2>The Turkish soldiers of the Korean War</h2>
      <p>Islam's modern story in Korea began on the battlefield. Turkish soldiers who came to defend Korea cared for war orphans and were the first to introduce Islam to Koreans.</p>
      <a href="/en/questions/islam-in-korea/">Read the story →</a>
    </div>
  </section>
</Base>
<style>
  .hero { padding-top: 24px; padding-bottom: 8px; }
  .hero h1 { font-size: clamp(2rem, 7vw, 3.2rem); margin-bottom: 0.4em; }
  .lead { font-size: 1.1rem; color: var(--muted); max-width: 600px; }
  .hero-search { display: flex; gap: 8px; max-width: 560px; margin-top: 24px; }
  .hero-search input { flex: 1; min-width: 0; border-radius: 999px; padding-left: 20px; }
  .section { margin-top: 56px; }
  .section h2 { margin-top: 0; }
  .story { background: var(--accent-soft); border: 0; padding: 28px; }
  .story h2 { margin: 0 0 8px; }
</style>
