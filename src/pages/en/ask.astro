---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';
---
<Base title="Ask a question" description="Ask anything about Islam." nextStep={false} lang="en">
  <div class="prose">
    <h1>Ask us anything</h1>
    <p>Anything you are curious about, uneasy about or worried about is fine to ask. We only reply if you ask us to.</p>

    {SITE.kakaoUrl && (
    <div class="card channel">
      <h2>Ask on KakaoTalk</h2>
      <p class="muted">The quickest and easiest way. You don't need to give your name.</p>
      <a class="btn btn-primary" href={SITE.kakaoUrl} target="_blank" rel="noopener">Open the KakaoTalk channel</a>
    </div>
    )}

    <div class="card channel">
      <h2>Write to us</h2>
      <iframe data-tally-src={`https://tally.so/embed/${SITE.tallyForm.en}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`} loading="lazy" width="100%" height="520" frameborder="0" title="Question form"></iframe>
      <script is:inline src="https://tally.so/widgets/embed.js" async></script>
      <script is:inline>
        (function () {
          var load = function () {
            if (window.Tally) { window.Tally.loadEmbeds(); return; }
            document.querySelectorAll('iframe[data-tally-src]:not([src])').forEach(function (f) { f.src = f.dataset.tallySrc; });
          };
          if (document.readyState === 'complete') load(); else window.addEventListener('load', load);
        })();
      </script>
      <noscript><p><a href={`https://tally.so/r/${SITE.tallyForm.en}`}>Open the question form</a></p></noscript>
    </div>

    <div class="card channel">
      <h2>Meet in person</h2>
      <p class="muted">Visit a mosque near you and talk with Muslims face to face.</p>
      <a class="btn btn-ghost" href="/en/mosques/">Find a mosque near you</a>
    </div>

    <h2>Questions worth reading first</h2>
    <p>The most common questions are collected in <a href="/en/questions/">Questions and answers</a>. If yours isn't there, we'll write it up as a new page.</p>
  </div>
</Base>
<style>
  .channel { margin: 16px 0; }
  .channel h2 { margin: 0 0 6px; font-size: 1.15rem; }
  .channel p { margin: 0 0 12px; }
  .check { font-weight: 400; display: flex; gap: 8px; align-items: center; }
</style>
