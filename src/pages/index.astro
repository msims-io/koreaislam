---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import QuestionCard from '../components/QuestionCard.astro';

// 홈에 보여줄 질문 6개 (순서대로)
const FEATURED = ['violence', 'hijab', 'jesus', 'allah', 'halal', 'women-rights'];
const all = await getCollection('questions');
const featured = FEATURED.map((id) => all.find((q) => q.id === id)).filter((q) => q !== undefined);
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: '궁금한 이슬람', inLanguage: 'ko' };
---
<Base jsonLd={jsonLd}>
  <section class="hero container">
    <p class="eyebrow">한국 무슬림이 직접 답합니다</p>
    <h1>이슬람에 대한 솔직한 답,<br />한국어로.</h1>
    <p class="lead">테러, 히잡, 예수, 할랄. 뉴스로만 접한 이슬람이 궁금하거나 걱정되셨다면, 여기서 차분히 알아보세요. 무엇을 믿으라고 강요하지 않아요.</p>
    <form class="hero-search" action="/questions/" method="get" role="search">
      <input type="search" name="q" placeholder="궁금한 것을 검색해 보세요 (예: 히잡)" aria-label="질문 검색" />
      <button class="btn btn-primary" type="submit">검색</button>
    </form>
  </section>

  <section class="container section">
    <h2>가장 많이 묻는 질문</h2>
    <div class="grid">
      {featured.map((q) => <QuestionCard id={q.id} title={q.data.title} answer={q.data.answer} />)}
    </div>
    <p><a href="/questions/">질문 모두 보기 →</a></p>
  </section>

  <section class="container section">
    <h2>나에게 맞는 길로 시작하기</h2>
    <p class="muted">어떤 배경에서 오셨는지에 따라 궁금한 것이 달라요.</p>
    <div class="grid paths">
      <a class="card card-link" href="/you/christian/">
        <h3>저는 기독교인이에요</h3>
        <p>같은 아브라함의 하나님, 꾸란 속의 예수와 마리아, 그리고 솔직한 차이점.</p>
      </a>
      <a class="card card-link" href="/you/buddhist/">
        <h3>저는 불교와 가까워요</h3>
        <p>마음 다스리기, 계율과 윤리, 수행으로서의 기도와 단식.</p>
      </a>
      <a class="card card-link" href="/you/non-religious/">
        <h3>저는 종교가 없어요</h3>
        <p>종교 없이도 잘 사는데, 왜 믿을까? 이성과 과학, 삶의 의미에 대한 질문들.</p>
      </a>
    </div>
  </section>

  <section class="container section">
    <div class="card story">
      <p class="eyebrow">한국과 이슬람</p>
      <h2>6·25 전쟁 때 온 튀르키예 군인들</h2>
      <p>한국 이슬람의 이야기는 전쟁터에서 시작됐어요. 한국을 지키러 온 튀르키예 군인들이 전쟁고아를 돌보며 이슬람을 처음 소개했습니다.</p>
      <a href="/questions/islam-in-korea/">이야기 읽기 →</a>
    </div>
  </section>
</Base>
<style>
  .hero { padding-top: 24px; padding-bottom: 8px; }
  .hero h1 { font-size: clamp(2rem, 7vw, 3.2rem); margin-bottom: 0.4em; }
  .lead { font-size: 1.1rem; color: var(--muted); max-width: 600px; }
  .hero-search { display: flex; gap: 8px; max-width: 560px; margin-top: 24px; }
  .hero-search input { flex: 1; min-width: 0; border-radius: 999px; padding-left: 20px; }
  .section { margin-top: 56px; }
  .section h2 { margin-top: 0; }
  .story { background: var(--accent-soft); border: 0; padding: 28px; }
  .story h2 { margin: 0 0 8px; }
</style>
