---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
---
<Base title="질문하기" description="이슬람에 대해 궁금한 것을 편하게 물어보세요." nextStep={false}>
  <div class="prose">
    <h1>무엇이든 물어보세요</h1>
    <p>이슬람에 대해 궁금한 점, 불편했던 점, 걱정되는 점, 무엇이든 괜찮아요. 답장은 원하실 때만 드려요.</p>

    {SITE.kakaoUrl && (
    <div class="card channel">
      <h2>카카오톡으로 물어보기</h2>
      <p class="muted">가장 빠르고 편한 방법이에요. 이름을 밝히지 않아도 돼요.</p>
      <a class="btn btn-primary" href={SITE.kakaoUrl} target="_blank" rel="noopener">카카오톡 채널 열기</a>
    </div>
    )}

    <div class="card channel">
      <h2>글로 남기기</h2>
      <iframe data-tally-src={`https://tally.so/embed/${SITE.tallyForm.ko}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`} loading="lazy" width="100%" height="520" frameborder="0" title="질문 양식"></iframe>
      <script is:inline src="https://tally.so/widgets/embed.js" async></script>
      <script is:inline>
        (function () {
          var load = function () {
            if (window.Tally) { window.Tally.loadEmbeds(); return; }
            document.querySelectorAll('iframe[data-tally-src]:not([src])').forEach(function (f) { f.src = f.dataset.tallySrc; });
          };
          if (document.readyState === 'complete') load(); else window.addEventListener('load', load);
        })();
      </script>
      <noscript><p><a href={`https://tally.so/r/${SITE.tallyForm.ko}`}>질문 양식 열기</a></p></noscript>
    </div>

    <div class="card channel">
      <h2>직접 만나 보기</h2>
      <p class="muted">가까운 성원에 찾아가 무슬림과 직접 이야기를 나눠 보세요.</p>
      <a class="btn btn-ghost" href="/mosques/">가까운 성원 찾기</a>
    </div>

    <h2>먼저 읽어 보시면 좋은 질문</h2>
    <p><a href="/questions/">질문과 답</a>에 자주 묻는 질문들을 정리해 두었어요. 거기 없는 질문은 새 글로 만들어 올릴게요.</p>
  </div>
</Base>
<style>
  .channel { margin: 16px 0; }
  .channel h2 { margin: 0 0 6px; font-size: 1.15rem; }
  .channel p { margin: 0 0 12px; }
  .check { font-weight: 400; display: flex; gap: 8px; align-items: center; }
</style>
